<!DOCTYPE html>
<html lang="pt-BR" class="locked">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Maya &amp; William — Aliança</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #150f1c;
    --surface: #201730;
    --surface-2: #2a1e3d;
    --hairline: rgba(240,232,250,0.10);
    --ink: #f3edfa;
    --ink-muted: #ab9dc2;
    --iris: #8f6fe0;
    --iris-dim: rgba(143,111,224,0.18);
    --orchid: #c774c9;
    --orchid-dim: rgba(199,116,201,0.18);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  html.locked{overflow:hidden;}

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
  }

  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Manrope', sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }

  body::before{
    content:"";
    position:fixed;
    inset:0;
    background:
      radial-gradient(circle at 18% 8%, rgba(143,111,224,0.12), transparent 45%),
      radial-gradient(circle at 82% 78%, rgba(199,116,201,0.10), transparent 50%);
    pointer-events:none;
    z-index:0;
  }

  .wrap{position:relative; z-index:1; max-width:560px; margin:0 auto; padding:0 24px;}

  h1,h2,h3{font-family:'Fraunces', serif; font-weight:500; margin:0;}

  section{padding:96px 0; border-bottom:1px solid var(--hairline);}
  section:last-of-type{border-bottom:none;}

  /* ---------- LANDING ---------- */
  .landing{
    position:fixed; inset:0; z-index:50;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:32px;
    background:
      radial-gradient(circle at 28% 22%, rgba(143,111,224,0.28), transparent 55%),
      radial-gradient(circle at 76% 80%, rgba(199,116,201,0.20), transparent 50%),
      var(--bg);
    transition:opacity 0.9s ease, transform 0.9s ease;
  }
  .landing.hide{opacity:0; transform:scale(1.05); pointer-events:none;}
  .landing .mark{
    width:8px; height:8px; border-radius:50%;
    background:var(--iris); margin-bottom:26px;
    box-shadow:0 0 0 8px var(--iris-dim);
  }
  .landing h1{
    font-size:46px; line-height:1.2; color:var(--ink); font-style:italic; font-weight:500;
  }
  .landing h1 .amp{
    color:var(--orchid); font-style:normal; margin:0 6px;
  }
  .landing p{
    margin-top:16px; color:var(--ink-muted); font-size:14px; letter-spacing:0.02em;
  }
  .enter-btn{
    margin-top:44px;
    display:inline-flex; align-items:center; gap:10px;
    background:var(--ink); color:var(--bg);
    border:none; padding:15px 26px; border-radius:999px;
    font-family:'Manrope',sans-serif; font-weight:600; font-size:14.5px;
    cursor:pointer;
  }
  .enter-btn:hover{background:var(--orchid); color:var(--ink);}
  .enter-btn:focus-visible{outline:2px solid var(--iris); outline-offset:3px;}
  .enter-btn svg{width:16px; height:16px;}

  /* ---------- HERO / PLAYER ---------- */
  .hero{padding-top:56px;}

  .eyebrow-row{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:28px;
  }
  .kicker{font-size:13px; color:var(--ink-muted); letter-spacing:0.02em;}
  .kicker b{color:var(--ink); font-weight:600;}

  .album{
    position:relative; border-radius:14px; overflow:hidden;
    box-shadow:0 30px 60px -20px rgba(0,0,0,0.6);
  }
  .album img{display:block; width:100%; aspect-ratio:4/5; object-fit:cover;}
  .album::after{
    content:""; position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(21,15,28,0) 55%, rgba(21,15,28,0.75) 100%);
  }

  .track-info{margin-top:26px;}
  .track-title{font-size:32px; line-height:1.15; color:var(--ink);}
  .track-artist{font-size:15px; color:var(--ink-muted); margin-top:6px;}

  .scrubber{margin-top:26px;}
  .scrub-track{position:relative; height:3px; background:var(--surface-2); border-radius:3px;}
  .scrub-fill{
    position:absolute; left:0; top:0; height:100%; width:0%;
    background:linear-gradient(90deg, var(--iris), var(--orchid));
    border-radius:3px; transition:width 1.4s ease;
  }
  .scrub-dot{
    position:absolute; top:50%; width:10px; height:10px; border-radius:50%;
    background:var(--ink); transform:translate(-50%,-50%); left:0%;
    transition:left 1.4s ease; box-shadow:0 0 0 4px rgba(243,237,250,0.14);
  }
  .scrub-labels{
    display:flex; justify-content:space-between; margin-top:10px;
    font-size:12px; color:var(--ink-muted); font-variant-numeric:tabular-nums;
  }

  .controls{display:flex; align-items:center; justify-content:center; gap:28px; margin-top:32px;}
  .controls button{
    background:none; border:none; color:var(--ink); cursor:pointer;
    display:flex; align-items:center; justify-content:center; padding:8px; border-radius:50%;
  }
  .controls button:focus-visible{outline:2px solid var(--iris); outline-offset:2px;}
  .controls .skip{opacity:0.45; width:20px; height:20px;}
  .play-btn{width:56px; height:56px; border-radius:50%; background:var(--ink); color:var(--bg);
    display:flex; align-items:center; justify-content:center;}
  .play-btn svg{width:20px; height:20px;}

  .eq{display:flex; align-items:flex-end; gap:3px; height:14px; margin-left:6px;}
  .eq span{width:3px; background:var(--iris); border-radius:2px; height:4px;}
  .eq.playing span{animation:eqBounce 0.9s ease-in-out infinite;}
  .eq span:nth-child(1){animation-delay:0s;}
  .eq span:nth-child(2){animation-delay:0.15s;}
  .eq span:nth-child(3){animation-delay:0.3s;}
  @keyframes eqBounce{0%,100%{height:4px;}50%{height:14px;}}

  .spotify-embed{margin-top:26px; border-radius:12px; overflow:hidden;}
  .spotify-embed iframe{display:block; border-radius:12px;}

  /* ---------- STATS ---------- */
  .stat-label{font-size:13px; color:var(--ink-muted); margin-bottom:14px;}
  .stat-number{
    font-family:'Fraunces', serif; font-weight:500; font-size:88px; line-height:1;
    font-variant-numeric:tabular-nums; letter-spacing:-0.01em;
  }
  .stat-since{color:var(--iris);}
  .stat-until{color:var(--orchid);}
  .stat-sub{margin-top:18px; font-size:16px; color:var(--ink-muted); max-width:38ch; line-height:1.5;}
  .stat-date{
    display:inline-flex; align-items:center; gap:8px; margin-top:22px; font-size:13px;
    color:var(--ink-muted); border-top:1px solid var(--hairline); padding-top:16px;
  }
  .dot{width:6px; height:6px; border-radius:50%;}
  .dot.iris{background:var(--iris);}
  .dot.orchid{background:var(--orchid);}

  /* ---------- SECTION HEAD ---------- */
  .section-head{margin-bottom:36px;}
  .section-head h2{font-size:28px; color:var(--ink);}
  .section-head p{font-size:15px; color:var(--ink-muted); margin-top:8px; max-width:40ch; line-height:1.55;}

  /* ---------- MOMENTS GALLERY ---------- */
  .moments{
    display:grid; grid-template-columns:1fr; gap:40px; max-width: 320px; margin: 0 auto;
  }
  .polaroid{
    background:#efe7f7;
    padding:8px 8px 22px;
    border-radius:3px;
    box-shadow:0 18px 30px -14px rgba(0,0,0,0.55);
  }
  .polaroid:nth-child(1){transform:rotate(-3deg);}
  .polaroid:nth-child(2){transform:rotate(2.5deg);}
  .polaroid:nth-child(3){transform:rotate(2deg);}
  .polaroid:nth-child(4){transform:rotate(-2deg);}
  .polaroid:nth-child(5){transform:rotate(1.5deg);}
  .polaroid:nth-child(6){transform:rotate(-1.5deg);}
  .polaroid:nth-child(7){transform:rotate(2.5deg);}
  .polaroid:nth-child(8){transform:rotate(-2.5deg);}
  .polaroid img{
    display:block; width:100%; aspect-ratio:3/4; object-fit:cover; border-radius:1px;
  }

  /* ---------- DRAWINGS ---------- */
  .frames{display:flex; flex-direction:column; gap:18px;}
  .frame{
    border-radius:12px; overflow:hidden;
    background:var(--surface);
    border:1px solid var(--hairline);
    box-shadow:0 18px 34px -18px rgba(0,0,0,0.55);
  }
  .frame img{display:block; width:100%; height:auto;}
  .frame figcaption{
    margin:0; padding:14px 16px 16px;
    font-size:13px; color:var(--ink-muted); font-style:italic;
    font-family:'Fraunces', serif;
  }

  /* ---------- LETTER ---------- */
  .letter{
    position:relative; background:var(--surface); border-radius:16px; padding:44px 32px;
    background-image:repeating-linear-gradient(to bottom, transparent, transparent 31px, var(--hairline) 32px);
  }
  .letter p{
    font-family:'Fraunces', serif; font-style:italic; font-weight:400; font-size:19px;
    line-height:32px; color:var(--ink); margin:0;
  }
  .letter .signoff{margin-top:28px; font-style:normal; font-weight:600; color:var(--iris);}

  /* ---------- CLOSING ---------- */
  .closing{text-align:center; padding-bottom:120px;}
  .closing .heart{width:34px; height:34px; margin:0 auto 26px; color:var(--orchid); animation:pulse 1.8s ease-in-out infinite;}
  @keyframes pulse{0%,100%{transform:scale(1);}50%{transform:scale(1.14);}}
  .closing h2{font-size:34px; line-height:1.25; color:var(--ink); max-width:20ch; margin:0 auto;}
  .replay{
    margin-top:36px; display:inline-flex; align-items:center; gap:10px;
    background:none; border:1px solid var(--hairline); color:var(--ink);
    padding:12px 22px; border-radius:999px; font-family:'Manrope',sans-serif;
    font-size:14px; cursor:pointer;
  }
  .replay:hover{border-color:var(--iris); color:var(--iris);}
  .replay:focus-visible{outline:2px solid var(--iris); outline-offset:2px;}
  .replay svg{width:15px; height:15px;}

  .reveal{opacity:0; transform:translateY(14px); transition:opacity 0.7s ease, transform 0.7s ease;}
  .reveal.in{opacity:1; transform:translateY(0);}

  @media (max-width:420px){
    .stat-number{font-size:64px;}
    .track-title{font-size:26px;}
    .closing h2{font-size:27px;}
    .landing h1{font-size:36px;}
  }
</style>
</head>
<body>

