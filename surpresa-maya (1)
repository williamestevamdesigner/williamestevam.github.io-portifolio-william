<audio id="audioPlayer" src="assets/alianca.mp3" loop></audio>

<script>
  var audioPlayer = document.getElementById('audioPlayer');
  // ---- landing ----
  var landing = document.getElementById('landing');
  var enterBtn = document.getElementById('enterBtn');
  enterBtn.addEventListener('click', function(){
    landing.classList.add('hide');
    document.documentElement.classList.remove('locked');
    setTimeout(function(){ landing.style.display = 'none'; }, 950);
    
    // Inicia a música quando clicar no botão de entrar
    audioPlayer.play().catch(function(e) { console.log('Autoplay bloqueado:', e); });
    playing = true;
    eq.classList.add('playing');
    playIcon.innerHTML = '<path d="M6 5h4v14H6zm8 0h4v14h-4z"/>';
    playBtn.setAttribute('aria-label', 'Pausar');
  });

  // ---- datas ----
  var lastSeen = new Date(2026, 3, 13); // 13/04/2026
  var reunion  = new Date(2026, 11, 18); // 18/12/2026
  var today    = new Date();

  function daysBetween(a, b){
    var msPerDay = 1000*60*60*24;
    var utcA = Date.UTC(a.getFullYear(), a.getMonth(), a.getDate());
    var utcB = Date.UTC(b.getFullYear(), b.getMonth(), b.getDate());
    return Math.round((utcB - utcA) / msPerDay);
  }

  var daysSince = Math.max(0, daysBetween(lastSeen, today));
  var daysUntil = Math.max(0, daysBetween(today, reunion));
  var totalSpan = Math.max(1, daysBetween(lastSeen, reunion));
  var progress = Math.min(100, Math.max(0, (daysSince / totalSpan) * 100));

  document.getElementById('scrubFill').style.width = progress + '%';
  document.getElementById('scrubDot').style.left = progress + '%';

  function countUp(el, target, duration){
    var start = null;
    function step(ts){
      if(!start) start = ts;
      var p = Math.min(1, (ts - start) / duration);
      var eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(eased * target);
      if(p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  // ---- play button ----
  var playing = false;
  var playBtn = document.getElementById('playBtn');
  var playIcon = document.getElementById('playIcon');
  var eq = document.getElementById('eq');
  playBtn.addEventListener('click', function(){
    playing = !playing;
    eq.classList.toggle('playing', playing);
    playIcon.innerHTML = playing
      ? '<path d="M6 5h4v14H6zm8 0h4v14h-4z"/>'
      : '<path d="M8 5v14l11-7z"/>';
    playBtn.setAttribute('aria-label', playing ? 'Pausar' : 'Tocar');
    
    if (playing) {
      audioPlayer.play();
    } else {
      audioPlayer.pause();
    }
  });

  // ---- scroll reveal ----
  var revealEls = document.querySelectorAll('.reveal');
  var counted = {};
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        entry.target.classList.add('in');
        if(entry.target.id === 'statsSince' && !counted.since){
          counted.since = true;
          var elS = document.getElementById('numSince');
          reduceMotion ? elS.textContent = daysSince : countUp(elS, daysSince, 1300);
        }
        if(entry.target.id === 'statsUntil' && !counted.until){
          counted.until = true;
          var elU = document.getElementById('numUntil');
          reduceMotion ? elU.textContent = daysUntil : countUp(elU, daysUntil, 1300);
        }
      }
    });
  }, {threshold:0.35});

  revealEls.forEach(function(el){ io.observe(el); });
</script>

</body>
